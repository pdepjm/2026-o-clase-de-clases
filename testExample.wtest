import sistema.*
import pizzas.*
import usuarios.*

describe "Usuarios" {

  test "Un usuario es pizzaficionado cuando tiene mas de 1000 crazyPizzaPoints" {
    var pizzaficionado = new Usuario(nombre ="Pizzaficionado")
    pizzaficionado.sumarPuntos(10000000000)
    assert.that(pizzaficionado.esPizzaficionado())
  }

    test "Un usuario NO es pizzaficionado cuando tiene menos de 1000 crazyPizzaPoints" {
        var noPizzaficionado = new Usuario(nombre ="noPizzaficionado")
        assert.notThat(noPizzaficionado.esPizzaficionado())
    }

    test "Un usuario NO es pizzaficionado cuando tiene exactamente 1000 crazyPizzaPoints" {
        var noPizzaficionado = new Usuario(nombre ="noPizzaficionado")
        noPizzaficionado.sumarPuntos(1000)
        assert.notThat(noPizzaficionado.esPizzaficionado())
    }

    test "No se puede vender una pizza a un usuario que no esta registrado" {
      var usuarioNoRegistrado = new Usuario(nombre="Pepita", metodoDePago = pdePay)
      assert.throwsExceptionWithMessage("No se puede vender a un usuario que no conozco", {sistema.venderPizza(usuarioNoRegistrado, jamonYMorron)})
    }
}